conda {
    cacheDir = "envs"
    createTimeout = "30 min"
}
process {
    executor='slurm'
    queue='production'
    time = '7 d'
    queueSize=500
    exitReadTimeout='100000 sec'
    pollInterval = '5sec'
}
executor {
    queueSize=1000
    perJobMemLimit=true
    pollInterval = '5sec'

    lsf {
        submitRateLimit = '1 / 15 s'
    }
}

params {
    contamination{
        ecoli {
            uri = 'ftp://ftp.ensemblgenomes.org/pub/release-61/bacteria/fasta/bacteria_0_collection/escherichia_coli_str_k_12_substr_mg1655_gca_000005845/dna/Escherichia_coli_str_k_12_substr_mg1655_gca_000005845.ASM584v2.dna.toplevel.fa.gz'
            assembly = 'str_k_12_substr_mg1655_gca_000005845'
        }
        fungi{
            uri = 'ftp://ftp.ncbi.nlm.nih.gov/refseq/release/fungi/fungi.36.rna.fna.gz'
            assembly = 'refseq_fungi_36'
        }
        viruses{
            uri = 'ftp://ftp.ncbi.nlm.nih.gov/refseq/release/viral/viral.1.1.genomic.fna.gz'
            assembly = 'refseq_viral.1.1'
        }
    }
}
